{
  "name": "meritbox",
  "version": "0.1.0",
  "private": true,
  "description": "Australian digital credentialing platform — Open Badges 3.0 / W3C Verifiable Credentials for universities, TAFEs and RTOs.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env --conditions=react-server prisma/seed.ts",
    "gen:master-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "prisma": {
    "seed": "tsx --env-file=.env --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1175.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "jose": "^6.2.18",
    "next": "^15.5.29",
    "otpauth": "^9.6.0",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "effect": "^3.22.5",
    "deepmerge-ts": "^8.0.2"
  }
}
