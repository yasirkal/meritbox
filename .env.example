# --- Core ---------------------------------------------------------------
# Public base URL. Determines issuer DIDs (did:web) and credential URLs, so pick it carefully
# before issuing real credentials — changing it later breaks verification of existing ones.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://meritbox:meritbox@localhost:5432/meritbox?schema=public

# 32 random bytes, base64. Encrypts signing keys, TOTP secrets and USIs at rest.
# Generate with: npm run gen:master-key   In production, source from AWS KMS / Secrets Manager.
MERITBOX_MASTER_KEY=

# --- Email (learner claim links, magic links) ------------------------------
# "log" stores messages in the outbox table (viewable at /dev/outbox outside production).
# "ses" sends via Amazon SES (AWS_REGION, default ap-southeast-2) using the task's IAM role.
EMAIL_TRANSPORT=log
EMAIL_FROM="Meritbox <no-reply@meritbox.com.au>"

# --- Security ---------------------------------------------------------------
SESSION_TTL_HOURS=12
# Contact for /.well-known/security.txt
SECURITY_CONTACT=mailto:security@meritbox.com.au

# Test/staging only: expose captured emails at /dev/outbox in a production build (used by tests/e2e).
# MERITBOX_DEV_OUTBOX=1

# MTA-STS policy served at /.well-known/mta-sts.txt (set to your inbound MX host, e.g. aspmx.l.google.com)
# MTA_STS_MX=
